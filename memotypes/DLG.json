{
 "code": "DLG",
 "order": 70,
 "title": {
  "en": "Delegation of Duties",
  "th": "มอบหมายหน้าที่ / รักษาการแทน"
 },
 "desc": {
  "en": "Deputy during a manager's absence, or delegation of a specific duty — OMA A.1.2",
  "th": "รักษาการระหว่างไม่อยู่ หรือมอบหน้าที่เฉพาะเรื่องให้คนอื่นทำแทน · เวียนถึงฝ่ายบริหาร"
 },
 "purpose": "inform",
 "requiresSignature": true,
 "circular": "always",
 "recipientsDefault": [
  "mgt"
 ],
 "signers": {
  "proposer": {
   "fromField": "absentee"
  },
  "endorser": {
   "position": "ACM",
   "conflictPosition": "HT",
   "actions": [
    "APPROVED",
    "ACKNOWLEDGED",
    "NOT APPROVED"
   ]
  }
 },
 "backdate": {
  "allowed": true,
  "statement": "ISSUED RETROSPECTIVELY. This memorandum records a delegation that took effect on {effectiveFromLong}.{retroReasonSentence} The date of issue is the date of signature and has not been back-dated."
 },
 "fields": [
  {
   "k": "dlgKind",
   "type": "select",
   "req": true,
   "label": {
    "en": "Kind",
    "th": "ลักษณะการมอบหมาย"
   },
   "opt": [
    {
     "v": "absence",
     "n": {
      "en": "Temporary absence (whole post)",
      "th": "รักษาการแทนระหว่างไม่อยู่ (ทั้งตำแหน่ง)"
     },
     "lead": "During the absence of {absenteeName} ({absPosTitle}) from {effectiveFromLong}{untilText}, {deputyName} is delegated to perform the duties of {absPosTitle} in accordance with OMA A.1.2.",
     "closing": "A handover briefing has been given to the deputy. Matters concerning this post shall be referred to {deputyName} during the period stated.",
     "kindTitle": "Delegation of duties"
    },
    {
     "v": "duty",
     "n": {
      "en": "Specific duty only",
      "th": "มอบหน้าที่เฉพาะเรื่อง"
     },
     "lead": "{absenteeName} ({absPosTitle}) delegates the following duty to {deputyName} with effect from {effectiveFromLong}{untilText}: {dutyText}.",
     "closing": "When this delegation ends, the duty reverts to {absenteeName}. {absenteeName} remains accountable for the duty delegated.",
     "kindTitle": "Delegation of duty"
    }
   ]
  },
  {
   "k": "absentee",
   "type": "person",
   "req": true,
   "label": {
    "en": "Manager delegating",
    "th": "ผู้มอบหมาย"
   }
  },
  {
   "k": "absPos",
   "type": "select",
   "req": true,
   "label": {
    "en": "Post",
    "th": "ตำแหน่ง"
   },
   "opt": [
    {
     "v": "HT",
     "n": {
      "en": "Head of Training",
      "th": "Head of Training"
     },
     "absPosTitle": "Head of Training"
    },
    {
     "v": "CFI",
     "n": {
      "en": "Chief Flight Instructor",
      "th": "Chief Flight Instructor"
     },
     "absPosTitle": "Chief Flight Instructor"
    },
    {
     "v": "CTKI",
     "n": {
      "en": "Chief Theoretical Knowledge Instructor",
      "th": "Chief Theoretical Knowledge Instructor"
     },
     "absPosTitle": "Chief Theoretical Knowledge Instructor"
    },
    {
     "v": "CMM",
     "n": {
      "en": "Compliance Monitoring Manager",
      "th": "Compliance Monitoring Manager"
     },
     "absPosTitle": "Compliance Monitoring Manager"
    },
    {
     "v": "SM",
     "n": {
      "en": "Safety Manager",
      "th": "Safety Manager"
     },
     "absPosTitle": "Safety Manager"
    },
    {
     "v": "MM",
     "n": {
      "en": "Maintenance Manager",
      "th": "Maintenance Manager"
     },
     "absPosTitle": "Maintenance Manager"
    },
    {
     "v": "ACM",
     "n": {
      "en": "Accountable Manager",
      "th": "Accountable Manager"
     },
     "absPosTitle": "Accountable Manager"
    },
    {
     "v": "OPS",
     "n": {
      "en": "Flight Operations",
      "th": "Flight Operations"
     },
     "absPosTitle": "Flight Operations"
    }
   ]
  },
  {
   "k": "dutyText",
   "type": "text",
   "label": {
    "en": "Duty delegated (specific duty only)",
    "th": "หน้าที่ที่มอบ (กรณีมอบเฉพาะเรื่อง)"
   },
   "ph": "e.g. authorisation of training flights"
  },
  {
   "k": "deputy",
   "type": "person",
   "req": true,
   "label": {
    "en": "Delegate / deputy",
    "th": "ผู้รับมอบ / ผู้รักษาการ"
   }
  },
  {
   "k": "effectiveFrom",
   "type": "date",
   "req": true,
   "label": {
    "en": "From",
    "th": "ตั้งแต่"
   }
  },
  {
   "k": "expiresOn",
   "type": "date",
   "req": false,
   "label": {
    "en": "To (blank = until further notice)",
    "th": "ถึง (เว้นว่าง = จนกว่าจะมีการเปลี่ยนแปลง)"
   }
  },
  {
   "k": "reason",
   "type": "text",
   "label": {
    "en": "Reason (optional)",
    "th": "เหตุผล (ไม่บังคับ)"
   }
  },
  {
   "k": "handover",
   "type": "check",
   "req": false,
   "label": {
    "en": "Handover briefing given to the deputy (OMA A.1.2 — required for absence)",
    "th": "ส่งมอบงานให้ผู้รับมอบแล้ว (OMA A.1.2 — บังคับเมื่อรักษาการระหว่างไม่อยู่)"
   }
  }
 ],
 "compute": [
  {
   "k": "untilText",
   "op": "tpl",
   "of": "expiresOn",
   "tpl": " to {expiresOnLong}",
   "else": " until further notice"
  },
  {
   "k": "reasonSentence",
   "op": "tpl",
   "of": "reason",
   "tpl": "Reason: {reason}."
  }
 ],
 "subject": "{kindTitle} — {absPosTitle} — {deputyName} from {effectiveFromLong}{untilText}",
 "body": [
  "{lead}",
  "{reasonSentence}",
  "{closing}"
 ]
}
