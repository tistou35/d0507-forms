  "gates": [
    { "when": "outcome == 'unsat'", "level": "warn",
      "short": { "th": "ไม่ผ่าน", "en": "UNSAT" },
      "msg": { "th": "ผลไม่ผ่าน — ต้องบันทึกการติดตามผล และพิจารณาเปิดการอบรมแก้ไขมาตรฐานตาม OMA D.2.8",
               "en": "Unsatisfactory — record the follow-up action and consider initiating corrective standardisation per OMA D.2.8." } }
  ],

  "route": [
    { "step": 1, "party": "ht", "sign": true },
    { "step": 2, "party": "ins", "sign": true, "assignedBy": "submitter", "slaDays": 7 }
