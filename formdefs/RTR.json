      "fields": [
        { "k": "trainerName", "type": "text", "req": true, "half": true,
          "label": { "th": "ชื่อผู้ฝึกอบรม", "en": "Trainer name" } },
        { "k": "trainerRole", "type": "text", "req": true, "half": true,
          "label": { "th": "คุณวุฒิ / บทบาท", "en": "Qualification / role" } }
      ]
    },
    {
