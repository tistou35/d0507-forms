    {
      "k": "F", "tab": "T3", "party": "ht",
      "title": { "th": "ลงนามหัวหน้าครูฝึก", "en": "Head of Training signature" },
      "fields": [
        { "k": "htName", "type": "text", "req": true, "half": true,
          "label": { "th": "ชื่อหัวหน้าครูฝึก", "en": "Head of Training name" } },
        { "k": "htDate", "type": "date", "req": true, "prefill": "today", "half": true,
          "label": { "th": "วันที่", "en": "Date" } },
        { "k": "htSign", "type": "sign", "req": true,
          "label": { "th": "ลายเซ็นหัวหน้าครูฝึก", "en": "Head of Training signature" } }
      ]
    },
    {
      "k": "G", "tab": "T3", "party": "ins", "hideOthers": true,
      "title": { "th": "ครูรับทราบ", "en": "Instructor acknowledgement" },
      "fields": [
        { "k": "insAckName", "type": "text", "req": true, "half": true,
          "label": { "th": "ชื่อครู", "en": "Instructor name" } },
        { "k": "insAckDate", "type": "date", "req": true, "half": true,
          "label": { "th": "วันที่", "en": "Date" } },
        { "k": "insSign", "type": "sign", "req": true,
          "label": { "th": "ลายเซ็นครู", "en": "Instructor signature" } }
