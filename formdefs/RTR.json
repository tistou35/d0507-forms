            { "v": "sat",   "n": { "th": "ผ่าน", "en": "Satisfactory" } },
            { "v": "unsat", "n": { "th": "ไม่ผ่าน", "en": "Unsatisfactory" } } ] },
        { "k": "comments", "type": "textarea", "reqIf": "outcome == 'unsat'",
          "label": { "th": "ความเห็น / การติดตามผล", "en": "Comments / follow-up action" } },
        { "k": "nextDue", "type": "date", "req": true, "half": true,
          "label": { "th": "กำหนดอบรมทบทวนครั้งถัดไป", "en": "Date of next due refresher" } },
        { "k": "scheduledBy", "type": "text", "half": true,
          "label": { "th": "ผู้กำหนดตาราง (ISM)", "en": "Scheduled by (ISM)" } }
