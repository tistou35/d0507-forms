 "gates": [
  {
   "when": "score >= 30",
   "level": "stop",
   "short": {
    "th": "EXTREME RISK!",
    "en": "EXTREME RISK!"
   },
   "msg": {
    "th": "EXTREME RISK! — ห้ามทำการบิน รอให้สภาพอากาศหรือเงื่อนไขเปลี่ยนก่อน",
    "en": "EXTREME RISK! Wait for conditions to change."
   }
  },
  {
   "when": "score >= 10 && score <= 29",
   "level": "warn",
   "short": {
    "th": "HIGH RISK!",
    "en": "HIGH RISK!"
   },
   "msg": {
    "th": "HIGH RISK! — ต้องมีแผนสำรองที่ชัดเจน และปรึกษาครูการบินหรือนักบินท่านอื่นก่อนตัดสินใจ",
    "en": "HIGH RISK! Have a serious alternative plan. Consult with FI or another pilot."
   }
  },
  {
   "when": "score >= 5 && score <= 9",
   "level": "warn",
   "short": {
    "th": "MODERATE",
    "en": "MODERATE"
   },
   "msg": {
    "th": "MODERATE — พิจารณาทางเลือกเพื่อลดความเสี่ยงบางข้อ",
    "en": "MODERATE. Consider an alternative to mitigate some risk item."
   }
  },
  {
   "when": "score <= 4",
   "level": "info",
   "short": {
    "th": "GOOD TO GO",
    "en": "GOOD TO GO"
   },
   "msg": {
    "th": "GOOD TO GO — คะแนนความเสี่ยงอยู่ในเกณฑ์ปกติ",
    "en": "GOOD TO GO"
   }
  },
  {
   "when": "decision == 'GO' && score >= 30",
   "level": "stop",
   "msg": {
    "th": "เลือก GO ไม่ได้เมื่อคะแนนอยู่ระดับ EXTREME",
    "en": "Cannot select GO at extreme risk level."
   }
  },
  {
   "when": "role == 'Student'",
   "level": "info",
   "msg": {
    "th": "นักเรียนการบิน — เมื่อส่งแล้วใบนี้จะเข้าคิวของครูการบินที่เลือกไว้ เพื่อลงนามอนุญาตก่อนจึงจะสมบูรณ์",
    "en": "Student — requires FI/HT authorisation before the record is complete."
   }
  }
 ],
