{
  "code": "FRAE",
  "doc": "D-0507-FRAE-001",
  "control": "IM-DRM-304-A",
  "issue": "01",
  "rev": "00",
  "eff": "07 JUL 2022",
  "title": {
    "th": "การประเมินความเสี่ยงก่อนทำการบิน",
    "en": "Flight Risk Assessment and Evaluation (FRAE)"
  },
  "retain": "OMA A.10",

  "parties": [
    { "k": "pic", "n": "PIC / นักเรียน", "auth": "public" },
    { "k": "fi",  "n": "Authorising FI / HT", "auth": "role:ins" }
  ],

  "sections": [
    {
      "k": "INFO",
      "title": { "th": "ข้อมูลเที่ยวบิน", "en": "Flight information" },
      "party": "pic",
      "fields": [
        { "k": "picFirst", "type": "text", "req": true,
          "label": { "th": "ชื่อ PIC", "en": "PIC name — first name" } },
        { "k": "picLast", "type": "text", "req": true,
          "label": { "th": "นามสกุล", "en": "Last name" } },
        { "k": "evalDate", "type": "date", "req": true,
          "label": { "th": "วันที่ประเมิน", "en": "Date (evaluation risk)" } },
        { "k": "aircraftReg", "type": "select", "req": true,
          "label": { "th": "ทะเบียนอากาศยาน", "en": "Aircraft reg." },
          "opt": [ { "v": "HS-VVD" }, { "v": "HS-VVB" }, { "v": "HS-CCM" },
                   { "v": "HS-VST" }, { "v": "HS-POP" }, { "v": "HS-BTM" } ] },
        { "k": "flightType", "type": "select", "req": true,
          "label": { "th": "ประเภทการบิน", "en": "Type of flight" },
          "opt": [ { "v": "VFR" }, { "v": "IFR" } ] }
      ]
    },

    {
      "k": "S1",
      "title": { "th": "ส่วนที่ 1 — การบินทั่วไป", "en": "Section 1 — General flight" },
      "party": "pic",
      "desc": { "th": "ติ๊กเฉพาะข้อที่ตรงกับสภาพจริง ตัวเลขในวงเล็บคือคะแนนความเสี่ยง" },
      "fields": [
        { "k": "s1Sigmet", "type": "check", "score": 5,
          "label": { "th": "บินผ่าน convective sigmet (แดง)", "en": "Convective sigmet (red) penetration" },
          "on": { "th": "ใช่ (5)" } },
        { "k": "s1Thunder", "type": "check", "score": 100,
          "label": { "th": "บินผ่านพายุฝนฟ้าคะนอง", "en": "Thunderstorm penetration" },
          "on": { "th": "ใช่ (100)" } },
        { "k": "s1Freezing", "type": "check", "score": 100,
          "label": { "th": "อาจมีฝนเยือกแข็ง / หมอก", "en": "Possible freezing rain / fog" },
          "on": { "th": "ใช่ (100)" } },
        { "k": "s1Autopilot", "type": "check", "score": 2,
          "label": { "th": "ระบบบินอัตโนมัติใช้การไม่ได้", "en": "Autopilot INOPS" },
          "on": { "th": "ใช่ (2)" } },
        { "k": "s1AfterMx", "type": "check", "score": 1,
          "label": { "th": "เที่ยวบินแรกหลังซ่อมบำรุง", "en": "First flight after maintenance" },
          "on": { "th": "ใช่ (1)" } },
        { "k": "s1Icing", "type": "select", "req": true,
          "label": { "th": "พยากรณ์หรือรายงานน้ำแข็งเกาะ", "en": "Forecast or report icing" },
          "opt": [ { "v": "none", "n": { "th": "ไม่มี (0)" } },
                   { "v": "light", "n": { "th": "เล็กน้อย (5)" } },
                   { "v": "moderate", "n": { "th": "ปานกลาง (50)" } },
                   { "v": "severe", "n": { "th": "รุนแรง SLD (100)" } } ],
          "score": { "light": 5, "moderate": 50, "severe": 100 } },
        { "k": "s1PrevFlight", "type": "select", "req": true,
          "label": { "th": "เป็นเที่ยวบินที่เท่าไรของวันนี้", "en": "Previous flight from today" },
          "opt": [ { "v": "1st", "n": { "th": "เที่ยวแรก (0)" } },
                   { "v": "2nd", "n": { "th": "เที่ยวที่ 2 (1)" } },
                   { "v": "3rd", "n": { "th": "เที่ยวที่ 3 (2)" } },
                   { "v": "gt3", "n": { "th": "มากกว่า 3 (2)" } } ],
          "score": { "2nd": 1, "3rd": 2, "gt3": 2 } }
      ]
    },

    {
      "k": "S2",
      "title": { "th": "ส่วนที่ 2 — ปัจจัยมนุษย์", "en": "Section 2 — Human factor" },
      "party": "pic",
      "fields": [
        { "k": "s2NotCurrent", "type": "check", "score": 3,
          "label": { "th": "ไม่ current ตามเกณฑ์ 90 วัน", "en": "Not 90-day current" }, "on": { "th": "ใช่ (3)" } },
        { "k": "s2Fatigue", "type": "check", "score": 3,
          "label": { "th": "ล้าหรือพักผ่อนไม่พอ", "en": "Fatigue or inadequate rest" }, "on": { "th": "ใช่ (3)" } },
        { "k": "s2AfterWork", "type": "check", "score": 1,
          "label": { "th": "บินต่อทันทีหลังเลิกงาน", "en": "Going to fly immediately after workday" }, "on": { "th": "ใช่ (1)" } },
        { "k": "s2Illness", "type": "check", "score": 3,
          "label": { "th": "เจ็บป่วย เป็นหวัด ไข้หวัดใหญ่", "en": "Illness, cold, flu" }, "on": { "th": "ใช่ (3)" } },
        { "k": "s2Personal", "type": "check", "score": 3,
          "label": { "th": "มีปัญหาความสัมพันธ์ส่วนตัว", "en": "Personal relationship issue" }, "on": { "th": "ใช่ (3)" } },
        { "k": "s2Business", "type": "check", "score": 3,
          "label": { "th": "มีปัญหาเรื่องงานหรือธุรกิจ", "en": "Business issue" }, "on": { "th": "ใช่ (3)" } },
        { "k": "s2Hunger", "type": "check", "score": 1,
          "label": { "th": "อดอาหารหรือกินน้อยกว่าปกติ", "en": "Starving or eating less food" }, "on": { "th": "ใช่ (1)" } }
      ]
    },

    {
      "k": "S3",
      "title": { "th": "ส่วนที่ 3 — สนามบินต้นทาง", "en": "Section 3 — Departure" },
      "party": "pic",
      "fields": [
        { "k": "s3Wind", "type": "check", "score": 3,
          "label": { "th": "ลม / ลมกระโชก > 20 kt", "en": "Wind / gust > 20 kt" }, "on": { "th": "ใช่ (3)" } },
        { "k": "s3Crosswind", "type": "check", "score": 3,
          "label": { "th": "ลมขวาง > 12 kt หรือทางวิ่งกว้าง < 50 ft", "en": "Crosswind > 12 kt / runway width < 50 ft" }, "on": { "th": "ใช่ (3)" } },
        { "k": "s3Night", "type": "check", "score": 2,
          "label": { "th": "ปฏิบัติการกลางคืน", "en": "Night operation" }, "on": { "th": "ใช่ (2)" } },
        { "k": "s3Precip", "type": "check", "score": 1,
          "label": { "th": "มีหยาดน้ำฟ้า", "en": "Precipitation" }, "on": { "th": "ใช่ (1)" } },
        { "k": "s3MaxWeight", "type": "check", "score": 1,
          "label": { "th": "น้ำหนักใกล้สูงสุดสำหรับวิ่งขึ้น", "en": "Near maximum take-off weight" }, "on": { "th": "ใช่ (1)" } },
        { "k": "s3Terrain", "type": "check", "score": 1,
          "label": { "th": "มีภูมิประเทศสูงชันใกล้เคียง", "en": "Steep terrain nearby" }, "on": { "th": "ใช่ (1)" } },
        { "k": "s3Runway", "type": "select", "req": true,
          "label": { "th": "สภาพทางวิ่งต้นทาง", "en": "DEP: runway condition" },
          "opt": [ { "v": "dry", "n": { "th": "แห้ง (0)" } },
                   { "v": "wet", "n": { "th": "เปียก (1)" } },
                   { "v": "standing", "n": { "th": "มีน้ำขัง (2)" } },
                   { "v": "soft", "n": { "th": "สนามอ่อน (3)" } },
                   { "v": "short", "n": { "th": "ทางวิ่ง < 2,000 ft (1)" } } ],
          "score": { "wet": 1, "standing": 2, "soft": 3, "short": 1 } },
        { "k": "s3Wx", "type": "check", "score": 2,
          "label": { "th": "เพดานเมฆ < 500 ft และ/หรือทัศนวิสัย < 1 SM", "en": "DEP: ceilings < 500 ft and/or visibility < 1 SM" },
          "on": { "th": "ใช่ (2)" } }
      ]
    },

    {
      "k": "S4",
      "title": { "th": "ส่วนที่ 4 — ระหว่างเส้นทาง", "en": "Section 4 — Enroute" },
      "party": "pic",
      "fields": [
        { "k": "s4Water", "type": "check", "score": 5,
          "label": { "th": "บินข้ามน้ำเกินระยะร่อน", "en": "Water crossing beyond glide distance" }, "on": { "th": "ใช่ (5)" } },
        { "k": "s4Mountain", "type": "check", "score": 5,
          "label": { "th": "บินข้ามเทือกเขาเกินระยะร่อน", "en": "Mountain range crossing beyond glide distance" }, "on": { "th": "ใช่ (5)" } },
        { "k": "s4NightIMC", "type": "check", "score": 2,
          "label": { "th": "กลางคืนหรือ IMC ระดับต่ำ", "en": "Night or ground-level IMC" }, "on": { "th": "ใช่ (2)" } },
        { "k": "s4LowPressure", "type": "check", "score": 1,
          "label": { "th": "ผ่านใกล้หย่อมความกดอากาศต่ำภายใน 75 NM", "en": "Passing within 75 NM of a low-pressure system" }, "on": { "th": "ใช่ (1)" } }
      ]
    },

    {
      "k": "S5",
      "title": { "th": "ส่วนที่ 5 — สนามบินปลายทาง", "en": "Section 5 — Destination" },
      "party": "pic",
      "fields": [
        { "k": "s5Wind", "type": "check", "score": 2,
          "label": { "th": "ลม / ลมกระโชก > 20 kt", "en": "Wind / gust > 20 kt" }, "on": { "th": "ใช่ (2)" } },
        { "k": "s5Crosswind", "type": "check", "score": 3,
          "label": { "th": "ลมขวาง > 12 kt หรือทางวิ่งกว้าง < 50 ft", "en": "Crosswind > 12 kt / runway width < 50 ft" }, "on": { "th": "ใช่ (3)" } },
        { "k": "s5Night", "type": "check", "score": 1,
          "label": { "th": "ปฏิบัติการกลางคืน", "en": "Night operation" }, "on": { "th": "ใช่ (1)" } },
        { "k": "s5Precip", "type": "check", "score": 1,
          "label": { "th": "มีหยาดน้ำฟ้า", "en": "Precipitation" }, "on": { "th": "ใช่ (1)" } },
        { "k": "s5Terrain", "type": "check", "score": 1,
          "label": { "th": "มีภูมิประเทศสูงชันใกล้เคียง", "en": "Steep terrain nearby" }, "on": { "th": "ใช่ (1)" } },
        { "k": "s5Windshear", "type": "check", "score": 5,
          "label": { "th": "ลมเฉือนระดับต่ำ", "en": "Low level windshear" }, "on": { "th": "ใช่ (5)" } },
        { "k": "s5Temp", "type": "check", "score": 1,
          "label": { "th": "อุณหภูมิ < 0 °C", "en": "Temperature < 0 °C" }, "on": { "th": "ใช่ (1)" } },
        { "k": "s5Spread", "type": "check", "score": 1,
          "label": { "th": "ผลต่างอุณหภูมิกับจุดน้ำค้าง < 3 °C", "en": "Temperature / dewpoint spread < 3 °C" }, "on": { "th": "ใช่ (1)" } },
        { "k": "s5Unfamiliar", "type": "check", "score": 1,
          "label": { "th": "สนามบินที่ไม่คุ้นเคย", "en": "Unfamiliar airport" }, "on": { "th": "ใช่ (1)" } },
        { "k": "s5NoTower", "type": "check", "score": 1,
          "label": { "th": "ไม่มีหอบังคับการบินให้บริการ", "en": "No operating tower" }, "on": { "th": "ใช่ (1)" } },
        { "k": "s5NoRadar", "type": "check", "score": 1,
          "label": { "th": "ไม่มีเรดาร์ครอบคลุมสำหรับการเข้าสนาม", "en": "No radar coverage for approach" }, "on": { "th": "ใช่ (1)" } },
        { "k": "s5Fuel", "type": "check", "score": 1,
          "label": { "th": "น้ำมันคงเหลือที่ปลายทางน้อยกว่า 1 ชม. 30 นาที", "en": "Less than 1 hr 30 min fuel at destination" }, "on": { "th": "ใช่ (1)" } },
        { "k": "s5Runway", "type": "select", "req": true,
          "label": { "th": "สภาพทางวิ่งปลายทาง", "en": "ARR: runway condition" },
          "opt": [ { "v": "dry", "n": { "th": "แห้ง (0)" } },
                   { "v": "wet", "n": { "th": "เปียก (1)" } },
                   { "v": "standing", "n": { "th": "มีน้ำขัง (3)" } },
                   { "v": "soft", "n": { "th": "สนามอ่อน (3)" } },
                   { "v": "short", "n": { "th": "ทางวิ่ง < 2,000 ft (1)" } } ],
          "score": { "wet": 1, "standing": 3, "soft": 3, "short": 1 } },
        { "k": "s5Wx", "type": "check", "score": 3,
          "label": { "th": "เพดานเมฆ < 500 ft และ/หรือทัศนวิสัย < 1 SM", "en": "ARR: ceilings < 500 ft and/or visibility < 1 SM" },
          "on": { "th": "ใช่ (3)" } }
      ]
    },

    {
      "k": "DEC",
      "title": { "th": "การตัดสินใจ", "en": "Go / No-go decision" },
      "party": "pic",
      "fields": [
        { "k": "decision", "type": "select", "req": true,
          "label": { "th": "ตัดสินใจ", "en": "GO / NO-GO" },
          "hint": { "th": "อ้างอิงคะแนนรวมด้านบนและเกณฑ์ในเอกสาร" },
          "opt": [ { "v": "GO" }, { "v": "NO-GO" } ] },
        { "k": "mitigation", "type": "textarea", "reqIf": "score >= 5",
          "label": { "th": "มาตรการลดความเสี่ยง", "en": "Mitigation" },
          "hint": { "th": "บังคับกรอกเมื่อคะแนนตั้งแต่ 5 ขึ้นไป — ระบุว่าจะลดความเสี่ยงข้อใดอย่างไร" } },
        { "k": "picSign", "type": "sign", "req": true,
          "label": { "th": "ลายเซ็น PIC / นักเรียน", "en": "PIC / Student signature" } }
      ]
    },

    {
      "k": "AUTH",
      "title": { "th": "การอนุญาตโดยครูการบิน", "en": "Authorisation" },
      "party": "fi",
      "desc": { "th": "ครูการบินหรือหัวหน้าครูฝึกตรวจผลการประเมินแล้วลงนามอนุญาต" },
      "fields": [
        { "k": "fiComment", "type": "textarea",
          "label": { "th": "ความเห็นของครูการบิน", "en": "Instructor comment" } },
        { "k": "fiSign", "type": "sign", "req": true,
          "label": { "th": "ลายเซ็น Authorising FI / HT", "en": "Authorising FI / HT signature" } }
      ]
    }
  ],

  "compute": [
    { "k": "score", "op": "sumScore" }
  ],

  "gates": [
    { "when": "score >= 30", "level": "stop",
      "msg": { "th": "EXTREME RISK! — ห้ามทำการบิน รอให้สภาพอากาศหรือเงื่อนไขเปลี่ยนก่อน",
               "en": "EXTREME RISK! Wait for conditions to change." } },
    { "when": "score >= 10 && score <= 29", "level": "warn",
      "msg": { "th": "HIGH RISK! — ต้องมีแผนสำรองที่ชัดเจน และปรึกษาครูการบินหรือนักบินท่านอื่นก่อนตัดสินใจ",
               "en": "HIGH RISK! Have a serious alternative plan. Consult with FI or another pilot." } },
    { "when": "score >= 5 && score <= 9", "level": "warn",
      "msg": { "th": "MODERATE — พิจารณาทางเลือกเพื่อลดความเสี่ยงบางข้อ",
               "en": "MODERATE. Consider an alternative to mitigate some risk item." } },
    { "when": "score <= 4", "level": "info",
      "msg": { "th": "GOOD TO GO — คะแนนความเสี่ยงอยู่ในเกณฑ์ปกติ", "en": "GOOD TO GO" } },
    { "when": "decision == 'GO' && score >= 30", "level": "stop",
      "msg": { "th": "เลือก GO ไม่ได้เมื่อคะแนนอยู่ระดับ EXTREME", "en": "Cannot select GO at extreme risk level." } }
  ],

  "route": [
    { "step": 1, "party": "pic", "sign": true },
    { "step": 2, "party": "fi", "sign": true, "assignedBy": "submitter", "slaDays": 1 }
  ],

  "export": {
    "docx": "D-0507-FRAE-001.docx",
    "lockUntilComplete": true,
    "draftWatermark": "DRAFT",
    "map": {}
  }
}
