 "compute": [
  {
   "k": "fltHours",
   "op": "sumCol",
   "of": "sheet",
   "col": "flt",
   "where": {
    "col": "type",
    "in": [
     "FLT"
    ]
   },
   "round": 2
  },
  {
   "k": "gndHours",
   "op": "sumCol",
   "of": "sheet",
   "col": "gnd",
   "round": 2
  },
  {
   "k": "fltPay",
   "op": "mul",
   "of": [
    "fltRate",
    "fltHours"
   ]
  },
  {
   "k": "gndPay",
   "op": "mul",
   "of": [
    "gndRate",
    "gndHours"
   ]
  },
  {
   "k": "accomTotal",
   "op": "mul",
   "of": [
    "accomNights",
    "accomRate"
   ]
  },
  {
   "k": "expTotal",
   "op": "sumCol",
   "of": "exp",
   "col": "amount",
   "round": 2
  },
  {
   "k": "reimburse",
   "op": "sum",
   "of": [
    "accomTotal",
    "expTotal"
   ]
  },
  {
   "k": "totalIncome",
   "op": "sum",
   "of": [
    "fltPay",
    "gndPay",
    "reimburse"
   ]
  },
  {
   "k": "afterTax",
   "op": "mul",
   "of": [
    "totalIncome",
    "0.97"
   ]
  },
  {
   "k": "sumFltPay",
   "op": "copy",
   "of": "fltPay"
  },
  {
   "k": "sumGndPay",
   "op": "copy",
   "of": "gndPay"
  },
  {
   "k": "sumReimburse",
   "op": "copy",
   "of": "reimburse"
  }
 ],
