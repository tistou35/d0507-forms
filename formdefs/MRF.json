 "compute": [
  {
   "k": "fltHours",
   "op": "sumCol",
   "of": "sheet",
   "col": "flt",
   "round": 2
  },
  {
   "k": "gndHours",
   "op": "sumCol",
   "of": "sheet",
   "col": "gnd",
   "round": 2
  },
  {
   "k": "mis",
   "op": "fn",
   "fn": "mrfMission",
   "_why": "คืนตัวเลขของตารางส่วนที่ 3 ทุกช่อง (m1* = D0507 · m2* = BSC · Qty/Rate/Amount) และ fltPay mTrv mAlw mDay misTot — ไม่มี misCfg = ค่าบินทั้งหมดลงคอลัมน์ D0507 ด้วยอัตรา fltRate · 27 NOV 2026",
   "out": [
    "misOn",
    "m1Code",
    "m2Code",
    "mFlt",
    "mTrv",
    "mAlw",
    "mDay",
    "misPay",
    "misTot",
    "fltPay",
    "misNote",
    "payBasis",
    "trvRetTxt",
    "m1Sub",
    "m2Sub",
    "m1FltN",
    "m1FltR",
    "m1Flt",
    "m1TrvN",
    "m1TrvR",
    "m1Trv",
    "m1AlwN",
    "m1AlwR",
    "m1Alw",
    "m1DayN",
    "m1DayR",
    "m1Day",
    "m2FltN",
    "m2FltR",
    "m2Flt",
    "m2TrvN",
    "m2TrvR",
    "m2Trv",
    "m2AlwN",
    "m2AlwR",
    "m2Alw",
    "m2DayN",
    "m2DayR",
    "m2Day"
   ]
  },
  {
   "k": "gndPay",
   "op": "mul",
   "of": [
    "gndRate",
    "gndHours"
   ],
   "round": 2
  },
  {
   "k": "gndHours2",
   "op": "copy",
   "of": "gndHours",
   "_why": "ชั่วโมงภาคพื้นพิมพ์สองที่บนกระดาษ (แถว TOTAL HOURS และตารางภาคพื้น) — token ตัวเดียววางได้ที่เดียว"
  },
  {
   "k": "payTotal",
   "op": "sum",
   "of": [
    "misTot",
    "gndPay"
   ],
   "round": 2
  },
  {
   "k": "accomFlat",
   "op": "mul",
   "of": [
    "accomNights",
    "accomRate"
   ],
   "round": 2
  },
  {
   "k": "accomTotal",
   "op": "sum",
   "of": [
    "accomFlat",
    "accomActual"
   ]
  },
  {
   "k": "perDiemTotal",
   "op": "mul",
   "of": [
    "perDiemDays",
    "perDiemRate"
   ],
   "round": 2
  },
  {
   "k": "expTotal",
   "op": "sumCol",
   "of": "exp",
   "col": "amount",
   "round": 2
  },
  {
   "k": "reimburse",
   "op": "sum",
   "of": [
    "accomTotal",
    "expTotal",
    "perDiemTotal"
   ],
   "round": 2
  },
  {
   "k": "totalIncome",
   "op": "sum",
   "of": [
    "payTotal",
    "reimburse"
   ],
   "round": 2
  },
  {
   "k": "rcptIncome",
   "op": "sumCol",
   "of": "exp",
   "col": "amount",
   "where": {
    "col": "remark",
    "re": "INCOME \\(WHT 3%\\)"
   },
   "round": 2,
   "_why": "ใบเสร็จที่ผู้เบิกเลือกรับเป็นรายได้ — นับเข้าฐานหัก ณ ที่จ่าย 3% · 26 NOV 2026"
  },
  {
   "k": "whtBase",
   "op": "sum",
   "of": [
    "payTotal",
    "accomFlat",
    "perDiemTotal",
    "rcptIncome"
   ],
   "round": 2,
   "_why": "ส่วนที่ไม่มีใบเสร็จ (ค่าตอบแทน ค่าเดินทาง เบี้ยเลี้ยง ค่าแรงรายวัน ที่พักเหมาจ่าย per diem) + ใบเสร็จที่รับเป็นรายได้ — ค่าใช้จ่ายตามใบเสร็จไม่หัก (ผู้ควบคุมเอกสาร 25 NOV 2026)"
  },
  {
   "k": "whtNegBase",
   "op": "mul",
   "of": [
    "whtBase",
    "-1"
   ]
  },
  {
   "k": "noWht",
   "op": "sum",
   "of": [
    "totalIncome",
    "whtNegBase"
   ],
   "round": 2
  },
  {
   "k": "whtAmt",
   "op": "mul",
   "of": [
    "whtBase",
    "0.03"
   ],
   "round": 2
  },
  {
   "k": "whtNeg",
   "op": "mul",
   "of": [
    "whtAmt",
    "-1"
   ]
  },
  {
   "k": "afterTax",
   "op": "sum",
   "of": [
    "totalIncome",
    "whtNeg"
   ],
   "round": 2
  },
  {
   "k": "empName2",
   "op": "copy",
   "of": "empName",
   "_why": "ชื่อผู้เบิกพิมพ์สองที่ (ส่วนที่ 1 และแถวลงนาม)"
  }
 ],
