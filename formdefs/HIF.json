            "th": "อธิบายอันตราย สภาพที่ไม่ปลอดภัย หรือต้นเหตุที่อาจก่อให้เกิดอันตราย",
            "en": "Describe the hazard, unsafe condition, or potential source of harm"
          }
        }
      ],
      "desc": {
        "th": "ใครก็แจ้งอันตรายได้ ไม่ต้องประเมินความเสี่ยงเอง · กรอกเท่าที่รู้แล้วส่ง ผู้จัดการความปลอดภัยจะวิเคราะห์และประเมินต่อในแท็บถัดไป",
        "en": "Anyone may report a hazard — you do not have to assess the risk yourself. Fill in what you know and submit; the Safety Manager analyses and assesses it next."
      }
    },
    {
      "k": "B",
      "tab": "T2",
      "party": "sm",
      "title": {
        "th": "เครื่องมือช่วยวิเคราะห์",
        "en": "Analysis tools"
      },
      "desc": {
        "th": "เลือกอย่างน้อยหนึ่งเครื่องมือ เลือกได้หลายอย่าง · เครื่องมือช่วยไม่ให้หยุดที่อาการ และทำให้การวิเคราะห์ของแต่ละเรื่องเทียบกันได้",
        "en": "Pick at least one tool; more than one is fine. The tools stop the analysis at the symptom and make separate reports comparable."
      },
      "fields": [
        {
          "k": "tools",
          "type": "multi",
          "req": true,
          "label": {
            "th": "เครื่องมือที่ใช้",
            "en": "Tools used"
          },
          "opt": [
            {
              "v": "why",
              "n": {
                "th": "5 Whys — ไล่หาสาเหตุราก",
                "en": "5 Whys — root cause"
              }
            },
            {
              "v": "tem",
              "n": {
                "th": "TEM — จัดหมวดภัยคุกคาม",
                "en": "TEM — threat category"
              }
            },
            {
              "v": "bow",
              "n": {
                "th": "Bow-tie — สาเหตุ เหตุการณ์ ผลที่ตามมา",
                "en": "Bow-tie — cause, event, consequence"
              }
            },
            {
              "v": "hist",
              "n": {
                "th": "เทียบรายงานเดิม",
                "en": "Compare with past reports"
              }
            }
          ]
        },
        {
          "k": "whyNote",
          "type": "static",
          "showIf": "tools has 'why'",
          "text": {
            "th": "<p><b>5 Whys</b> — ถามต่อจากคำตอบก่อนหน้า ไม่ใช่ถามใหม่ทุกชั้น หยุดเมื่อถึงสิ่งที่องค์กรแก้ได้ ไม่ใช่หยุดที่ตัวบุคคล</p>",
            "en": "<p><b>5 Whys</b> — each question follows on from the previous answer, not a fresh question each time. Stop when you reach something the organisation can change, not when you reach a person.</p>"
          }
        },
        {
          "k": "why1",
          "type": "textarea",
          "showIf": "tools has 'why'",
          "reqIf": "tools has 'why'",
          "label": {
            "th": "ทำไม ครั้งที่ 1",
            "en": "Why 1"
          }
        },
        {
          "k": "why2",
          "type": "textarea",
          "showIf": "tools has 'why'",
          "reqIf": "tools has 'why'",
          "label": {
            "th": "ทำไม ครั้งที่ 2",
            "en": "Why 2"
          }
        },
        {
          "k": "why3",
          "type": "textarea",
          "showIf": "tools has 'why'",
          "reqIf": "tools has 'why'",
          "label": {
            "th": "ทำไม ครั้งที่ 3",
            "en": "Why 3"
          }
        },
        {
          "k": "why4",
          "type": "textarea",
          "showIf": "tools has 'why'",
          "label": {
            "th": "ทำไม ครั้งที่ 4",
            "en": "Why 4"
          }
        },
        {
          "k": "why5",
          "type": "textarea",
          "showIf": "tools has 'why'",
          "label": {
            "th": "ทำไม ครั้งที่ 5",
            "en": "Why 5"
          }
        },
        {
          "k": "temKind",
          "type": "multi",
          "showIf": "tools has 'tem'",
          "reqIf": "tools has 'tem'",
          "label": {
            "th": "ภัยคุกคามมาจากไหน",
            "en": "Where does the threat come from"
          },
          "hint": {
            "th": "เลือกได้หลายข้อ — ภัยหนึ่งอย่างมักมีต้นทางมากกว่าหนึ่งทาง",
            "en": "More than one may apply — a single threat often has more than one source."
          },
          "opt": [
            {
              "v": "env",
              "n": {
                "th": "สภาพแวดล้อม — อากาศ ภูมิประเทศ สนามบิน จราจร",
                "en": "Environmental — weather, terrain, aerodrome, traffic"
              }
            },
            {
              "v": "org",
              "n": {
                "th": "องค์กร — ขั้นตอน ตารางงาน เครื่องมือ การฝึก",
                "en": "Organisational — procedures, scheduling, equipment, training"
              }
            },
            {
              "v": "hum",
              "n": {
                "th": "คน — ความล้า การสื่อสาร ภาระงาน ความชำนาญ",
                "en": "Human — fatigue, communication, workload, currency"
              }
            }
          ]
        },
        {
          "k": "temNote",
          "type": "textarea",
          "showIf": "tools has 'tem'",
          "label": {
            "th": "อธิบายภัยคุกคามที่จัดหมวดไว้",
            "en": "Describe the threats categorised above"
          }
        },
        {
          "k": "bowNote",
          "type": "static",
          "showIf": "tools has 'bow'",
          "text": {
            "th": "<p><b>Bow-tie</b> — เขียนเหตุการณ์ตรงกลางก่อน แล้วค่อยกรอกสองข้าง ซ้ายคือสิ่งที่ทำให้เกิด ขวาคือสิ่งที่ตามมา มาตรการฝั่งซ้ายคือการ<b>ป้องกัน</b> ฝั่งขวาคือการ<b>ลดความเสียหาย</b> ถ้ามีแต่ฝั่งขวาแปลว่ายังไม่ได้กันไม่ให้เกิด</p>",
            "en": "<p><b>Bow-tie</b> — write the event in the middle first, then fill both sides. Left is what causes it, right is what follows. Left-hand controls <b>prevent</b>; right-hand controls <b>reduce the damage</b>. Only right-hand controls means nothing is stopping it happening.</p>"
          }
        },
        {
          "k": "bowCause",
          "type": "textarea",
          "showIf": "tools has 'bow'",
          "reqIf": "tools has 'bow'",
          "label": {
            "th": "สาเหตุที่ทำให้เกิด",
            "en": "Causes"
          }
        },
        {
          "k": "bowEvent",
          "type": "text",
          "showIf": "tools has 'bow'",
          "reqIf": "tools has 'bow'",
          "label": {
            "th": "เหตุการณ์ที่ไม่ต้องการ",
            "en": "Unwanted event"
          }
        },
        {
          "k": "bowConseq",
          "type": "textarea",
          "showIf": "tools has 'bow'",
          "reqIf": "tools has 'bow'",
          "label": {
            "th": "ผลที่ตามมา",
            "en": "Consequences"
          }
        },
        {
          "k": "bowPrevent",
          "type": "textarea",
          "showIf": "tools has 'bow'",
          "label": {
            "th": "มาตรการป้องกัน (ฝั่งสาเหตุ)",
            "en": "Preventive controls (cause side)"
          }
        },
        {
          "k": "bowRecover",
          "type": "textarea",
          "showIf": "tools has 'bow'",
          "label": {
            "th": "มาตรการลดความเสียหาย (ฝั่งผล)",
            "en": "Recovery controls (consequence side)"
          }
        },
        {
          "k": "histNote",
          "type": "static",
          "showIf": "tools has 'hist'",
          "text": {
            "th": "<p><b>เทียบรายงานเดิม</b> — เรื่องที่เคยเกิดซ้ำเปลี่ยนการประเมินโอกาสได้จริง ค้นรายงานเก่าด้วยคำสำคัญ แล้วบันทึกว่าเจอกี่เรื่องและเรื่องอะไร ถ้าเคยเกิดแล้วยังเกิดอีก แปลว่ามาตรการเดิมไม่ได้ผล ต้องเขียนไว้ด้วย</p>",
            "en": "<p><b>Compare with past reports</b> — a recurrence genuinely changes the likelihood rating. Search earlier reports by keyword, then record how many and which ones. If it has happened before and happened again, the earlier mitigation did not work and that belongs here too.</p>"
          }
        },
        {
          "k": "histFound",
          "type": "number",
          "showIf": "tools has 'hist'",
          "reqIf": "tools has 'hist'",
          "min": 0,
          "half": true,
          "label": {
            "th": "จำนวนรายงานเดิมที่คล้ายกัน",
            "en": "Similar past reports found"
          }
        },
        {
          "k": "histRefs",
          "type": "textarea",
          "showIf": "tools has 'hist'",
          "label": {
            "th": "เลขที่รายงานและสิ่งที่เคยทำไป",
            "en": "Report numbers and what was done then"
          }
        }
      ],
      "hideOthers": true
    },
    {
      "k": "C",
      "tab": "T3",
      "party": "sm",
      "title": {
        "th": "ประเมินความเสี่ยง",
        "en": "Risk assessment"
      },
      "desc": {
        "th": "กดช่องในตารางเพื่อกำหนดโอกาสและความรุนแรงพร้อมกัน · สีบอกระดับตาม ICAO Doc 9859",
        "en": "Click a cell to set likelihood and severity together. Colours follow the ICAO Doc 9859 scheme."
      },
      "fields": [
        {
          "k": "matrix",
