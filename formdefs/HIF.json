  "gates": [
    {
      "when": "riskLevel == 'H'",
      "level": "stop",
      "short": {
        "th": "ความเสี่ยงสูง",
        "en": "HIGH RISK"
      },
      "msg": {
        "th": "ความเสี่ยงสูง — ต้องดำเนินการทันที ห้ามปล่อยไว้ ผู้จัดการนิรภัยต้องพิจารณาโดยเร็วที่สุด",
        "en": "High risk — immediate action required."
      }
    },
    {
      "when": "riskLevel == 'A'",
      "level": "warn",
      "short": {
        "th": "ความเสี่ยงปานกลาง",
        "en": "MEDIUM RISK"
      },
      "msg": {
        "th": "ความเสี่ยงปานกลาง — ต้องมีมาตรการรองรับ",
        "en": "Medium risk — action required."
      }
    },
    {
      "when": "riskLevel == 'L'",
      "level": "info",
      "short": {
        "th": "ความเสี่ยงต่ำ",
        "en": "LOW RISK"
      },
      "msg": {
        "th": "ความเสี่ยงต่ำ — เฝ้าติดตาม",
        "en": "Low risk — monitor."
      }
    },
    {
      "when": "residualOk == 'no'",
      "level": "warn",
      "msg": {
        "th": "ความเสี่ยงคงเหลือยอมรับไม่ได้ — ต้องเสนอมาตรการเพิ่มก่อนปิดเรื่อง",
        "en": "Residual risk not acceptable — further action must be proposed."
      }
    }
  ],
  "route": [
    {
      "step": 1,
      "party": "rep",
      "sign": true
    },
    {
      "step": 2,
      "party": "sm",
      "sign": true,
      "assignedBy": "later",
      "pool": "SM",
      "canDelegate": true,
      "slaDays": 2
    }
  ],
