              "L",
              "A"
            ],
            "1": [
              "L",
              "L",
              "L",
              "L",
              "L"
            ]
          },
          "xLab": {
            "th": "โอกาสเกิด (1 นาน ๆ ครั้ง → 5 เกิดแน่)",
            "en": "Likelihood (1 rare → 5 almost certain)"
          },
          "yLab": {
            "th": "ความรุนแรง",
            "en": "Severity"
          },
          "pick": {
