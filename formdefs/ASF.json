{
  "code": "ASF",
  "doc": "D-0507-ASF-001",
  "control": "IM-ASF-003-A",
  "issue": "01",
  "rev": "00",
  "eff": "07 JUL 2022",
  "title": { "th": "ใบอนุญาตบินเดี่ยว", "en": "Authorisation for Solo Flight" },
  "retain": "OMA A.10",

  "ui": {
    "compact": true,
    "tabs": [
      { "k": "T1", "th": "ข้อมูลเที่ยวบิน", "en": "Flight" },
      { "k": "T2", "th": "ตรวจก่อนบินเดี่ยว", "en": "Pre-solo checklist" },
      { "k": "T3", "th": "อนุญาต", "en": "Authorisation" }
    ]
  },

  "parties": [
    { "k": "stu", "n": { "th": "นักเรียน", "en": "Student" }, "auth": "public" },
    { "k": "fi",  "n": { "th": "ครูการบิน", "en": "Flight Instructor" }, "auth": "role:ins" },
    { "k": "ht",  "n": { "th": "หัวหน้าครูฝึก", "en": "Head of Training" }, "auth": "role:mgt" }
  ],

  "sections": [
    {
      "k": "A", "tab": "T1", "party": "stu",
      "title": { "th": "นักเรียนและครูการบิน", "en": "Student and instructor" },
      "fields": [
        { "k": "stuName", "type": "text", "req": true, "half": true,
          "label": { "th": "ชื่อนักเรียน", "en": "Student name" } },
        { "k": "stuContact", "type": "text", "req": true, "half": true,
          "label": { "th": "อีเมล / Line ID ของนักเรียน", "en": "Student email / Line ID" } },
        { "k": "insName", "type": "text", "req": true, "half": true,
          "label": { "th": "ชื่อครูการบิน", "en": "Instructor name" } },
        { "k": "insContact", "type": "text", "req": true, "half": true,
          "label": { "th": "อีเมล / Line ID ของครูการบิน", "en": "Instructor email / Line ID" } }
      ]
    },
    {
      "k": "B", "tab": "T1", "party": "stu",
      "title": { "th": "เที่ยวบิน", "en": "Flight details" },
      "fields": [
        { "k": "acType", "type": "text", "req": true, "half": true,
          "label": { "th": "แบบอากาศยาน", "en": "Aircraft type" } },
        { "k": "acReg", "type": "text", "req": true, "half": true, "def": "HS-",
          "label": { "th": "ทะเบียนอากาศยาน", "en": "Aircraft registration" }, "ph": "HS-___" },
        { "k": "fltDate", "type": "date", "req": true, "prefill": "today", "half": true,
          "label": { "th": "วันที่บิน", "en": "Date" } },
        { "k": "lesson", "type": "text", "req": true, "half": true,
          "label": { "th": "บทเรียนที่", "en": "Lesson of flight" } },
        { "k": "soloType", "type": "select", "req": true,
          "label": { "th": "ประเภทการบินเดี่ยว", "en": "Type of solo flight" },
          "opt": [
            { "v": "initial", "n": { "th": "บินเดี่ยวครั้งแรก", "en": "Initial solo" } },
            { "v": "localxc", "n": { "th": "บินเดี่ยวในสนาม / นอกเส้นทาง", "en": "Solo local / cross-country" } },
            { "v": "night",   "n": { "th": "บินเดี่ยวกลางคืน", "en": "Night solo local / cross-country" } } ] }
      ]
    },
    {
      "k": "C", "tab": "T2", "party": "fi",
      "title": { "th": "ชั่วโมงบินและจำนวนครั้งขึ้นลง", "en": "Flight hours and landings" },
      "desc": { "th": "ครูการบินต้องตรวจยืนยันทุกข้อด้วยตนเองก่อนอนุญาต",
                "en": "The instructor shall personally verify each item before authorising." },
      "fields": [
        { "k": "c1Hours", "type": "check", "req": true,
          "label": { "th": "ชั่วโมงบินและจำนวนครั้งขึ้นลง (ฝึกมาแล้ว ≥ 15 ชม. · ขึ้นลง ≥ 50 ครั้ง)",
                     "en": "Flight hours & landings (≥ 15 hr training | ≥ 50 take-off and landing)" } },
        { "k": "c2Night", "type": "check", "reqIf": "soloType == 'night'",
          "label": { "th": "ชั่วโมงบินกลางคืนและขึ้นลงกลางคืน (ฝึกกลางคืน ≥ 3 ชม. · ขึ้นลงกลางคืน ≥ 5 ครั้ง)",
                     "en": "Night hours & landings (≥ 3 hr night training | ≥ 5 night T/O and landing)" } }
      ]
    },
    {
      "k": "D", "tab": "T2", "party": "fi",
      "title": { "th": "ความรู้ที่จำเป็น", "en": "Essential knowledge" },
      "fields": [
        { "k": "k1Systems", "type": "check", "req": true,
          "label": { "th": "ระบบอากาศยานและการบังคับควบคุม", "en": "Aircraft systems & flight controls" } },
        { "k": "k2Aero", "type": "check", "req": true,
          "label": { "th": "หลักอากาศพลศาสตร์", "en": "Aerodynamics" } },
        { "k": "k3Emerg", "type": "check", "req": true,
          "label": { "th": "ขั้นตอนฉุกเฉิน", "en": "Emergency procedures" } },
        { "k": "k4Law", "type": "check", "req": true,
          "label": { "th": "ห้วงอากาศ กฎหมายและระเบียบการบิน", "en": "Airspace, air laws & regulations" } },
        { "k": "k5Wx", "type": "check", "req": true,
          "label": { "th": "อุตุนิยมวิทยา — การแปลผลและการตัดสินใจ", "en": "Weather — interpretation & decision-making" } },
        { "k": "k6Preflight", "type": "check", "req": true,
          "label": { "th": "ขั้นตอนก่อนบินและเอกสารประกอบ", "en": "Pre-flight procedures & documentation" } },
        { "k": "k7Radio", "type": "check", "req": true,
          "label": { "th": "ขั้นตอนการติดต่อสื่อสารทางวิทยุ", "en": "Radio communication procedures" } }
      ]
    },
    {
      "k": "E", "tab": "T2", "party": "fi", "showIf": "soloType == 'night'",
      "title": { "th": "เพิ่มเติมสำหรับบินเดี่ยวกลางคืน", "en": "Night solo — additional" },
      "fields": [
        { "k": "n1Vision", "type": "check", "reqIf": "soloType == 'night'",
          "label": { "th": "การมองเห็นกลางคืนและสรีรวิทยา", "en": "Night vision & physiology" } },
        { "k": "n2Lighting", "type": "check", "reqIf": "soloType == 'night'",
          "label": { "th": "ระบบไฟของอากาศยาน", "en": "Aircraft lighting systems" } },
        { "k": "n3Disorient", "type": "check", "reqIf": "soloType == 'night'",
          "label": { "th": "การหลงสภาพการบิน — การรู้ตัวและการแก้ไข", "en": "Spatial disorientation — recognition & recovery" } },
        { "k": "n4Nav", "type": "check", "reqIf": "soloType == 'night'",
          "label": { "th": "การเดินอากาศกลางคืน", "en": "Night navigation" } }
      ]
    },
    {
      "k": "F", "tab": "T3", "party": "fi",
      "title": { "th": "ครูการบินรับรอง", "en": "Instructor certification" },
      "fields": [
        { "k": "insLicence", "type": "text", "req": true,
          "label": { "th": "เลขที่ใบอนุญาตครูการบิน", "en": "Instructor licence No." } },
        { "k": "insSign", "type": "sign", "req": true,
          "label": { "th": "ลายเซ็นครูการบิน", "en": "Instructor signature" } }
      ]
    },
    {
      "k": "G", "tab": "T3", "party": "ht", "hideOthers": true,
      "title": { "th": "หัวหน้าครูฝึกอนุมัติ", "en": "Head of Training authorisation" },
      "fields": [
        { "k": "htName", "type": "text", "req": true, "half": true,
          "label": { "th": "ชื่อหัวหน้าครูฝึก", "en": "Head of Training name" } },
        { "k": "htDate", "type": "date", "req": true, "half": true,
          "label": { "th": "วันที่อนุมัติ", "en": "Date approved" } },
        { "k": "htComment", "type": "textarea",
          "label": { "th": "ความเห็น", "en": "Comment" } },
        { "k": "htSign", "type": "sign", "req": true,
          "label": { "th": "ลายเซ็นหัวหน้าครูฝึก", "en": "Head of Training signature" } }
      ]
    }
  ],

  "gates": [
    { "when": "soloType == 'night' && c2Night != true", "level": "stop",
      "short": { "th": "ชั่วโมงกลางคืนไม่ครบ", "en": "NIGHT MINIMA" },
      "msg": { "th": "บินเดี่ยวกลางคืนต้องผ่านเกณฑ์ชั่วโมงกลางคืนและจำนวนครั้งขึ้นลงกลางคืนก่อน",
               "en": "Night solo requires the night hours and night landing minima to be verified first." } },
    { "when": "soloType == 'initial'", "level": "info",
      "msg": { "th": "บินเดี่ยวครั้งแรก — ต้องได้รับอนุมัติจากหัวหน้าครูฝึกก่อนออกบินทุกกรณี",
               "en": "Initial solo always requires Head of Training authorisation before the flight." } }
  ],

  "route": [
    { "step": 1, "party": "stu", "sign": false },
    { "step": 2, "party": "fi", "sign": true, "assignedBy": "submitter", "slaDays": 1 },
    { "step": 3, "party": "ht", "sign": true, "assignedBy": "later", "pool": "HT",
      "canDelegate": true, "slaDays": 1 }
  ],

  "export": { "docx": "D-0507-ASF-001.docx", "lockUntilComplete": true }
}
