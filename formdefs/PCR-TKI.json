    {
      "k": "B",
      "tab": "T2",
      "party": "con",
      "title": {
        "th": "การประเมินครูภาคทฤษฎี",
        "en": "Theoretical Knowledge Instructor evaluation"
      },
      "desc": {
        "th": "เกณฑ์การให้คะแนนตาม IM-ECA-301-A · ★ = การถ่ายทอดเนื้อหาที่เกี่ยวกับความปลอดภัย เกรด 1 หรือ 2 = ไม่ผ่านทันที · เกณฑ์ผ่าน คือเกรด 3 ขึ้นไปทุกข้อ",
        "en": "Grading per IM-ECA-301-A. ★ = delivery of safety-critical content: grade 1 or 2 is an automatic fail. Pass standard: grade 3+ in ALL areas."
      },
      "fields": [
        {
          "k": "g1",
          "type": "grade",
          "max": 5,
          "req": true,
          "label": {
            "th": "การวางแผนบทเรียน",
            "en": "Lesson planning"
          },
          "hint": {
            "th": "สอดคล้องกับหลักสูตร CAAT · ระบุวัตถุประสงค์การเรียนรู้ · ระยะเวลาเหมาะสม · เตรียมสื่อการสอน",
            "en": "CAAT syllabus alignment, learning objectives defined, appropriate duration, materials prepared"
          }
        },
        {
          "k": "g2",
          "type": "grade",
          "max": 5,
          "req": true,
          "star": true,
          "label": {
            "th": "การถ่ายทอด (รวมเนื้อหาด้านความปลอดภัย)",
            "en": "Delivery (including safety-critical content)"
          },
          "hint": {
            "th": "โครงสร้าง · ความชัดเจน · เนื้อหาทางเทคนิคถูกต้อง · ใช้สื่อที่ได้รับอนุมัติ · จังหวะเหมาะสม",
            "en": "Structure, clarity, correct technical content, approved materials, appropriate pace"
          }
        },
        {
          "k": "g3",
          "type": "grade",
          "max": 5,
          "req": true,
          "label": {
            "th": "การมีส่วนร่วมของนักเรียน",
            "en": "Student engagement"
          },
          "hint": {
            "th": "เทคนิคการตั้งคำถาม · ตรวจสอบความเข้าใจ · ปรับตามการตอบสนองของชั้นเรียน",
            "en": "Questioning technique, checking understanding, adapting to class response"
          }
        },
        {
          "k": "g4",
          "type": "grade",
          "max": 5,
          "req": true,
          "label": {
            "th": "การวัดและประเมินผล",
            "en": "Assessment"
          },
          "hint": {
            "th": "ใช้เครื่องมือวัดผลถูกต้อง · ตรวจให้คะแนนสม่ำเสมอ · ให้ข้อติชมเป็นลายลักษณ์อักษร",
            "en": "Assessment tools applied correctly, consistent marking, written feedback provided"
          }
        },
        {
          "k": "g5",
          "type": "grade",
          "max": 5,
          "req": true,
          "label": {
            "th": "การบริหารชั้นเรียน",
            "en": "Classroom management"
          },
          "hint": {
            "th": "ขั้นตอนเช็กชื่อ · การบริหารเวลา · การกำกับความประพฤติของนักเรียน",
            "en": "Attendance procedure, time management, student conduct managed"
          }
        },
        {
          "k": "g6",
          "type": "grade",
          "max": 5,
          "req": true,
          "label": {
            "th": "การจัดทำเอกสาร",
            "en": "Documentation"
          },
          "hint": {
            "th": "ความถูกต้องของบันทึกการเข้าเรียน · การบันทึกความคืบหน้า · การส่งผลเข้าระบบบันทึกการฝึก",
            "en": "Accuracy of attendance records, progress entries, submissions to the training records system"
          }
        }
      ]
    },
    {
