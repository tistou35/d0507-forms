            "en": "D.2.8 corrective standardisation initiated"
          }
        },
        {
          "k": "htNotified",
          "type": "date",
          "showIf": "correctiveInit == 'yes'",
          "half": true,
          "label": {
            "th": "วันที่แจ้งหัวหน้าครูฝึก",
            "en": "Date notified to HT"
          }
        }
      ]
    },
