  "compute": [
    {
      "k": "total",
      "op": "sum",
      "of": [
        "g1",
        "g2",
        "g3",
        "g4",
        "g5",
        "g6",
        "g7"
      ]
    },
    {
      "k": "pct",
      "op": "pct",
      "of": "total",
      "max": 35
    }
  ],
  "gates": [
    {
      "when": "anyStarBelow(3)",
      "level": "stop",
      "short": {
        "th": "ไม่ผ่าน — ข้อความปลอดภัย",
        "en": "SAFETY FAIL"
      },
      "msg": {
        "th": "ไม่ผ่านทันที — ความปลอดภัยและวินัยการบิน ได้เกรด 2 หรือต่ำกว่า ตาม OMA D.2.9.5 ถือว่าไม่ผ่านไม่ว่าคะแนนรวมจะเป็นเท่าใด",
        "en": "Automatic fail — Safety and Airmanship graded 2 or below. Per OMA D.2.9.5 this fails the check regardless of any other score."
      }
    },
    {
      "when": "anyBelow(2)",
      "level": "stop",
      "short": {
        "th": "ไม่ผ่าน — มีเกรด 1",
        "en": "GRADE 1 — FAIL"
      },
      "msg": {
        "th": "ไม่ผ่านทันที — OMA D.2.9.5 ระบุว่าเกรด 1 ในข้อใดก็ตามคือไม่ผ่าน · ให้พักการปฏิบัติหน้าที่ในส่วนที่เกี่ยวข้อง แจ้งหัวหน้าครูฝึกภายในวันเดียวกัน และเปิดการอบรมแก้ไขมาตรฐานตาม D.2.8 ภายใน 5 วันทำการ",
        "en": "Automatic fail — OMA D.2.9.5: grade 1 in any area is a fail. Suspend from the affected duties, notify the HT the same day, and initiate D.2.8 corrective standardisation within 5 working days."
      }
    },
    {
      "when": "countBelow(3) > 2",
      "level": "stop",
      "short": {
        "th": "ไม่ผ่าน — ต่ำกว่าเกณฑ์เกิน 2 ข้อ",
        "en": "FAIL — >2 AREAS"
      },
      "msg": {
        "th": "ไม่ผ่าน — OMA D.2.9.5 ระบุว่าเกรด 2 ในข้อที่ไม่ใช่ safety-critical เกินสองข้อคือไม่ผ่าน · ผ่านแบบมีเงื่อนไขใช้ได้กับหนึ่งถึงสองข้อเท่านั้น",
        "en": "Fail — OMA D.2.9.5: grade 2 in more than two non-safety-critical areas is a fail. Marginal pass applies to one or two areas only."
      }
    },
    {
      "when": "countBelow(3) >= 1 && countBelow(3) <= 2 && anyBelow(2) == false && anyStarBelow(3) == false",
      "level": "warn",
      "short": {
        "th": "ผ่านแบบมีเงื่อนไข",
        "en": "MARGINAL PASS"
      },
      "msg": {
        "th": "เกณฑ์ผ่านคือเกรด 3 ขึ้นไปทุกข้อ — มีข้อต่ำกว่าเกณฑ์ 1–2 ข้อ เข้าข่ายผ่านแบบมีเงื่อนไขตาม OMA D.2.9.5 · ให้บันทึกข้อที่ต้องปรับปรุง และนัดสังเกตการณ์ติดตามผลในการตรวจครั้งถัดไปหรือภายใน 6 เดือน",
        "en": "Pass standard is grade 3+ in every area. One or two areas below standard is a Marginal Pass per OMA D.2.9.5 — document the improvement areas and schedule a follow-up observation at the next check or within 6 months."
      }
    }
  ],
