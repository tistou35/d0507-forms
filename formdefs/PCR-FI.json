    {
      "k": "B",
      "tab": "T2",
      "party": "con",
      "title": {
        "th": "การประเมินครูการบิน",
        "en": "Flight Instructor evaluation"
      },
      "desc": {
        "th": "เกณฑ์การให้คะแนนตาม IM-ECA-301-A · ★ = ข้อสำคัญด้านความปลอดภัย เกรด 1 หรือ 2 = ไม่ผ่านทันที · เกณฑ์ผ่าน คือเกรด 3 ขึ้นไปทุกข้อ",
        "en": "Grading per IM-ECA-301-A. ★ = safety-critical: grade 1 or 2 is an automatic fail. Pass standard: grade 3+ in ALL areas."
      },
      "fields": [
        {
          "k": "g1",
          "type": "grade",
          "max": 5,
          "req": true,
          "label": {
            "th": "การบรีฟก่อนบิน",
            "en": "Pre-flight briefing"
          },
          "hint": {
            "th": "โครงบทเรียน · ระบุวัตถุประสงค์ · ครอบคลุมสภาพอากาศ · ขั้นตอนฉุกเฉิน · ยืนยันความพร้อมของนักเรียน",
            "en": "Lesson structure, objectives stated, weather covered, emergency procedures, student preparation confirmed"
          }
        },
        {
          "k": "g2",
          "type": "grade",
          "max": 5,
          "req": true,
          "label": {
            "th": "การสาธิตและเทคนิค",
            "en": "Demonstration and technique"
          },
          "hint": {
            "th": "ความแม่นยำของท่าบิน · เทคนิคตามมาตรฐาน ATO · การคุมความเร็วและระดับความสูง",
            "en": "Accuracy of manoeuvre, ATO standard technique, correct airspeed / altitude management"
          }
        },
        {
          "k": "g3",
          "type": "grade",
          "max": 5,
          "req": true,
          "label": {
            "th": "การบรรยายประกอบการสอน",
            "en": "Instructional patter"
          },
          "hint": {
            "th": "ความชัดเจน · ลำดับถูกต้อง · ถ้อยคำมาตรฐาน · จังหวะเหมาะสม · ไม่มีนิสัยการสอนที่ไม่พึงประสงค์",
            "en": "Clarity, correct sequence, standard phraseology, appropriate pace, absence of negative habits"
          }
        },
        {
          "k": "g4",
          "type": "grade",
          "max": 5,
          "req": true,
          "label": {
            "th": "การดูแลนักเรียน",
            "en": "Student management"
          },
          "hint": {
            "th": "การจับข้อผิดพลาด · จังหวะและวิธีเข้าแทรก · วิธีแก้ไข",
            "en": "Recognition of errors, intervention timing and method, correction technique"
          }
        },
        {
          "k": "g5",
          "type": "grade",
          "max": 5,
          "req": true,
          "star": true,
          "label": {
            "th": "ความปลอดภัยและวินัยการบิน",
            "en": "Safety and airmanship"
          },
          "hint": {
            "th": "การใช้ TEM · การรู้สถานการณ์รอบตัว · การตัดสินใจ · การตัดสินใจ go-around",
            "en": "TEM application, situational awareness, decision-making, go-around judgment"
          }
        },
        {
          "k": "g6",
          "type": "grade",
          "max": 5,
          "req": true,
          "label": {
            "th": "การบรีฟหลังบิน",
            "en": "Post-flight debrief"
          },
          "hint": {
            "th": "โครงสร้างการบรีฟ · ข้อติชมที่เจาะจง · ระบุสิ่งที่ต้องปรับปรุง · รักษากำลังใจนักเรียน",
            "en": "Structure, specific feedback, improvement actions identified, student motivation maintained"
          }
        },
        {
          "k": "g7",
          "type": "grade",
          "max": 5,
          "req": true,
          "label": {
            "th": "การจัดทำเอกสาร",
            "en": "Documentation"
          },
          "hint": {
            "th": "ความถูกต้องและครบถ้วนของ FRAE, AFM และบันทึกการฝึกของนักเรียน",
            "en": "Accuracy and completeness of FRAE, AFM, student training records"
          }
        }
      ]
    },
