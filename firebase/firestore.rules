rules_version = '2';

// ============================================================
// d0507-forms — Firestore Security Rules
// โปรเจกต์นี้ "แยกขาด" จาก d0507-audit (ตัดสินใจ 01 AUG 2026)
// จึงไม่มี audits / plans / library อยู่ที่นี่ และแก้ rules ที่นี่
// ไม่กระทบระบบตรวจสอบเลย
//
// ทดสอบก่อนวางจริง:  firebase emulators:start --only firestore
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    /* ── ใครคือเจ้าหน้าที่ ───────────────────────────────────
       ดูจาก "บทบาทในโปรไฟล์" (users/{uid}.roles) ซึ่งผู้ดูแลระบบเป็นคนตั้งให้
       ตรงกับที่หน้าเว็บใช้ตัดสินอยู่แล้ว (A.STAFF_ROLES ใน assets/app.js)

       เดิมเป็นรายชื่ออีเมลตายตัวและมีอีเมลเดียว เจ้าหน้าที่คนอื่นจึงอ่านทะเบียน
       อ่านคิวงาน และอนุมัติใบไม่ได้เลย ใบที่ส่งถึงเขาค้างอยู่อย่างนั้น
       (ทดลองด้วยบัญชีที่มีบทบาท ins แล้วได้ 403 ทั้งทะเบียน คิวงาน และรายชื่อเจ้าหน้าที่)

       ปลอมบทบาทให้ตัวเองไม่ได้ — users/{uid} คนอื่นเขียนได้เฉพาะเจ้าหน้าที่
       ส่วนเจ้าตัวเขียนได้แค่ตอนสมัครครั้งแรกและถูกบังคับให้เป็น ['stu'] เท่านั้น
       (ดู selfProfileOk / selfProfileEditOk ข้างล่าง)

       บัญชีที่ถูกปิดใช้งาน (active: false) ไม่นับเป็นเจ้าหน้าที่ แม้บทบาทยังอยู่

       staffEmails ยังอยู่เป็นทางสำรอง — ถ้าโปรไฟล์ของผู้ดูแลเสียหรือถูกลบ
       ต้องยังมีคนเข้าไปแก้ได้ ไม่งั้นระบบล็อกตัวเองทั้งระบบ */
    function staffEmails() {
      return [
        'tistou35@gmail.com'
      ];
    }
    function staffRoles() { return ['ins', 'mnt', 'ops', 'mgt', 'sms']; }
    function signedIn()  { return request.auth != null; }
    function meDoc()     { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasStaffRole() {
      return exists(meDoc())
          && get(meDoc()).data.get('active', true) == true
          && get(meDoc()).data.get('roles', []).hasAny(staffRoles());
    }
    function staff() {
      return signedIn()
          && (request.auth.token.get('email', '') in staffEmails() || hasStaffRole());
    }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    // ฝั่งนักเรียนล็อกอินแบบ anonymous เพื่อให้ส่งฟอร์มได้โดยไม่ต้องสมัคร
    function anon()      { return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous'; }

    // ── ผู้ดูแลระบบ — แก้ทะเบียน นิยามฟอร์ม ผังผู้อนุมัติ ────
    // เก็บรายชื่อ uid ไว้ที่ config/admins
    //
    // ตอนเริ่มต้น เอกสารนั้นยังไม่มี → เจ้าหน้าที่ทุกคนเป็น admin ชั่วคราว
    // เพื่อให้ตั้งคนแรกได้ พอบันทึกรายชื่อครั้งแรกแล้ว เหลือเฉพาะ uid ในรายชื่อ
    // ⚠️ อย่าปล่อยให้ไม่มี config/admins นาน — ตั้งคนแรกทันทีหลังวาง rules
    function adminsDoc()  { return /databases/$(database)/documents/config/admins; }
    function noAdminYet() { return !exists(adminsDoc()); }
    function admin() {
      return staff() && (noAdminYet()
        || get(adminsDoc()).data.uids.hasAny([request.auth.uid]));
    }

    /* ── โปรไฟล์ + บทบาท ────────────────────────────────────
       ทุกคนที่กรอกฟอร์มต้องล็อกอิน นักเรียนจึงสมัครบัญชีเองได้ และเขียนโปรไฟล์
       ของตัวเองได้ครั้งแรก — แต่ตั้งบทบาทให้ตัวเองไม่ได้ ได้ stu อย่างเดียว
       บทบาทเจ้าหน้าที่ต้องให้ผู้ดูแลตั้งให้ (หน้าตั้งค่าระบบ)

       แก้ทีหลังได้เฉพาะชื่อกับใบอนุญาต ส่วน roles และ active ต้องเท่าเดิมทุกตัวอักษร
       ไม่งั้นนักเรียนเติม 'mgt' ให้ตัวเองแล้วเห็นทะเบียนทั้งระบบ */
    function selfProfileOk(uid) {
      let d = request.resource.data;
      return isSelf(uid)
          && d.roles == ['stu']
          && d.keys().hasOnly(['email', 'name', 'roles', 'active', 'createdAt', 'self'])
          && d.active == true;
    }
    function selfProfileEditOk(uid) {
      let d = request.resource.data;
      return isSelf(uid)
          && d.roles == resource.data.roles
          && d.get('active', true) == resource.data.get('active', true);
    }
    match /users/{uid} {
      allow read:   if isSelf(uid) || staff();
      allow create: if staff() || selfProfileOk(uid);
      allow update: if staff() || selfProfileEditOk(uid);
      allow delete: if staff();
    }

    // ── รายชื่อผู้รับฟอร์ม สำหรับตัวเลือกฝั่งนักเรียน ────────
    // อ่านได้ทั้งโลก → ใส่ได้แค่ ชื่อ + ตำแหน่ง + recv
    // ห้ามมีอีเมลหรือเบอร์โทรเด็ดขาด (seed.mjs ตรวจให้แล้ว)
    match /publicDirectory/{doc} {
      allow read:  if true;
      allow write: if admin();
    }

    // ── ทะเบียนฟอร์มฉบับเต็ม ────────────────────────────────
    // มี control code · สถานะ LEF · หมายเหตุ
    // เว็บ host แบบสาธารณะจึงฝังในไฟล์ไม่ได้ ต้องอ่านจากที่นี่หลัง login
    match /registry/{doc} {
      allow read:  if staff();
      allow write: if admin();
    }

    /* เช็กลิสต์ที่สร้างในระบบ — ใครก็เปิดอ่านและพิมพ์ได้ เจ้าหน้าที่เท่านั้นที่แก้
       ลบไม่ได้: เป็นเอกสารควบคุมที่มีเลขคุม ฉบับที่เลิกใช้ต้องเก็บไว้
       ไม่ใช่หายไปจากระบบ ให้ปิดการใช้งานด้วย active:false แทน */
    match /checklists/{clId} {
      allow read:          if true;
      allow create, update: if staff();
      allow delete:        if false;

      // ฉบับที่ถูกแทนที่ — เขียนเพิ่มได้ แก้ของเดิมไม่ได้
      match /versions/{rev} {
        allow read:   if true;
        allow create: if staff();
        allow update, delete: if false;
      }
    }

    // ── นิยามฟอร์ม — หน้าสาธารณะต้องใช้จึงอ่านได้ทั้งโลก ────
    // ห้ามใส่ข้อมูลควบคุมภายใน (control code / สถานะ LEF) ลงในนิยามฟอร์ม
    match /formDefs/{formCode} {
      allow read:  if true;
      allow write: if admin();

      // สำเนาแช่แข็งของแต่ละรุ่นที่ publish — เขียนได้ครั้งเดียว แก้ไม่ได้ ลบไม่ได้
      // record ที่กรอกไว้ผูกกับรุ่นนี้ ถ้าแก้ย้อนหลังได้จะไม่ใช่เอกสารควบคุมอีกต่อไป
      match /versions/{defRev} {
        allow read:   if true;
        allow create: if staff();
        allow update, delete: if false;
      }

      // log การแก้ไข — append-only ใช้ generate editor note และ revision log
      match /events/{eventId} {
        allow read:   if staff();
        allow create: if staff();
        allow update, delete: if false;
      }
    }

    /* ── การแจกจ่ายเอกสารควบคุม (DRC) ────────────────────
       ผู้ดูแล/CCM บันทึกไว้ก่อนว่าประกาศรอบนี้แจกเอกสารอะไรบ้าง แล้วได้ลิงก์
       ลิงก์เดียวส่งให้ทุกคนผ่านประกาศใน AeroFBO — ผู้รับแต่ละคนกดเข้ามา
       กรอกชื่อตัวเองแล้วเซ็น จึงต้องอ่านได้โดยไม่ต้องล็อกอิน

       ในเอกสารนี้มีแต่ชื่อเอกสารที่แจกและชื่อผู้แจกจ่าย ไม่มีชื่อหรืออีเมล
       ของผู้รับ — รายชื่อผู้รับเกิดจากใบที่แต่ละคนส่งเข้ามาเอง
       ลบไม่ได้: ใบรับที่ลงนามแล้วอ้างถึงเอกสารนี้เป็นหลักฐานว่าแจกอะไรไป */
    match /distributions/{distId} {
      allow read:           if true;
      allow create, update: if staff();
      allow delete:         if false;
    }

    /* ── การแก้ไขต้นฉบับเอกสารควบคุม ─────────────────────────
       หนึ่งเอกสารต่อหนึ่งครั้งที่มีคนกดแก้ต้นฉบับ — ทั้งแก้เล็กน้อยในฉบับเดิม
       และขอออก Revision/Issue ใหม่ที่ผูกกับ DRF และฉบับร่าง
       ลบไม่ได้: เป็นบันทึกว่าใครแตะต้นฉบับเมื่อไร และฉบับร่างไหนถูกอนุมัติหรือตีกลับ */
    match /revisions/{revId} {
      allow read, create, update: if staff();
      allow delete:               if false;
    }

    // ── ฟอร์มที่ถูกส่ง ──────────────────────────────────────
    // หลักการ: ผู้ที่ไม่ได้ล็อกอิน (นักเรียน) สร้างได้เฉพาะใบที่ "ต้องมีคนอื่นอนุมัติ"
    //   · status ต้องเป็น pending เท่านั้น — ปิดใบเองไม่ได้
    //   · ต้องระบุผู้รับที่มีตัวตนจริง ใบจึงมีคนรับผิดชอบเสมอ
    // ใบที่จบทันทีที่ส่ง (ไม่มีขั้นอนุมัติ) ต้องล็อกอินเป็นเจ้าหน้าที่ก่อน
    function newSubmissionOk() {
      let d = request.resource.data;
      return d.keys().hasAll(['formCode', 'tracking', 'status', 'assigneeUid', 'submittedAt'])
          && d.status == 'pending'
          // มีผู้รับระบุตัว หรือระบุกองที่รับผิดชอบ — อย่างใดอย่างหนึ่งต้องมี
          // ปล่อยให้ว่างทั้งคู่ = ใบลอยไม่มีใครรับผิดชอบ
          && d.assigneeUid is string
          && (d.assigneeUid.size() > 0
              || (d.assignTo is string && d.assignTo.size() > 0))
          && d.formCode  is string && d.formCode.size()  <= 40
          && d.tracking  is string && d.tracking.size()  <= 60
          && d.submittedAt == request.time   // ใช้เวลาเซิร์ฟเวอร์ ปลอมย้อนหลังไม่ได้
          && d.keys().size() <= 22;
    }

    /* ใบรับเอกสารควบคุม — จบในขั้นเดียวตอนผู้รับเซ็น ไม่มีใครต้องอนุมัติต่อ
       จึงเข้าเงื่อนไข newSubmissionOk() ไม่ได้ (นั่นบังคับ status 'pending')
       สิ่งที่ใช้แทนคือต้องอ้าง distributions ที่มีอยู่จริง — เขียนใบได้เฉพาะ
       คนที่ถือลิงก์จากประกาศ ไม่ใช่ใครก็ยิงใบเข้ามาได้ */
    function newReceiptOk() {
      let d = request.resource.data;
      return d.formCode == 'DRC'
          && d.status == 'complete'
          && d.distId is string && d.distId.size() > 0
          && exists(/databases/$(database)/documents/distributions/$(d.distId))
          && d.tracking is string && d.tracking.size() <= 60
          && d.submittedAt == request.time
          && d.keys().size() <= 22;
    }

    /* ── ใบที่จบตั้งแต่ขั้นตอนแรก ─────────────────────────────
       บางใบไม่มีใครต้องอนุมัติต่อ ระบบจึงปิดใบให้ทันทีที่กดส่ง (status 'complete')
       ซึ่งเข้า newSubmissionOk() ไม่ได้ เพราะนั่นบังคับ 'pending'
       ผลคือทุกคนที่ไม่ได้อยู่ใน staffEmails() กดส่งใบพวกนี้ไม่ได้เลย —
       รายงานเข้ามาจริงกับ FRAE ของนักบินที่บินคนเดียว

       ใบไหนบ้าง: ดูจาก route ในนิยามฟอร์ม (formdefs/) ที่มีขั้นเดียว
         PWR  ผู้โดยสารลงนามสละสิทธิ์ จบในตัว
         EFC  รายงานจบหลักสูตร หัวหน้าครูฝึกเป็นคนบันทึก ไม่มีขั้นอนุมัติ
         BCK  รายการตรวจการบรรยายก่อนบิน ครูการบินกับนักเรียนลงนามพร้อมกันหน้างาน
         FRAE จบขั้นเดียว "เฉพาะเมื่อผู้ประเมินเป็น PIC" (route.onlyIf role == 'Student')
              จึงบังคับ data.role == 'PIC' ไว้ตรงนี้ด้วย ไม่งั้นเที่ยวฝึกของนักเรียน
              จะปิดใบตัวเองข้ามครูการบินได้
         DRC  มีกติกาของตัวเองอยู่แล้ว (newReceiptOk — ต้องอ้างประกาศที่มีจริง)

       ใบต้องเป็นของคนที่ส่งเอง และเวลาส่งใช้เวลาเซิร์ฟเวอร์ ปลอมย้อนหลังไม่ได้ */
    function soloForms() { return ['PWR', 'EFC', 'BCK']; }
    function newSoloOk() {
      let d = request.resource.data;
      return d.status == 'complete'
          && d.submitterUid == request.auth.uid
          && d.submittedAt == request.time
          && d.formCode is string
          && d.tracking  is string && d.tracking.size() <= 60
          && d.keys().size() <= 22
          && (d.formCode in soloForms()
              || (d.formCode == 'FRAE' && d.data.role == 'PIC'));
    }

    match /submissions/{subId} {
      /* ผู้ส่งอ่านใบของตัวเองได้ (งานของฉัน · หน้าดูใบ · พิมพ์) — ใบของคนอื่นยังอ่านไม่ได้
         ต้อง query ด้วย where('submitterUid','==',uid) ไม่งั้น rule ไม่ผ่านทั้งชุด
         anonymous (PWR · VSR) ได้ uid ใหม่ทุกครั้ง จึงเปิดย้อนดูไม่ได้อยู่แล้ว — ถูกต้องสำหรับ VSR */
      /* คนกรอกคือทุกคนที่ล็อกอิน — นักเรียนที่มีบัญชี หรือ anonymous สำหรับใบที่
         คนกรอกไม่ใช่คนในระบบ (PWR ผู้โดยสาร · VSR รายงานนิรภัยไม่ระบุตัว)
         เงื่อนไขที่กันของเสียคือ newSubmissionOk() ไม่ใช่วิธีล็อกอิน */
      allow create: if staff() || (signedIn() && (newSubmissionOk() || newReceiptOk() || newSoloOk()));
      allow read:   if staff() || (signedIn() && resource.data.submitterUid == request.auth.uid);
      allow update: if staff();
      allow delete: if false;

      // log แบบ append-only — แก้ไม่ได้ ลบไม่ได้ (ข้อกำหนดเอกสารควบคุม)
      match /events/{eventId} {
        allow create: if signedIn();
        allow read:   if staff();
        allow update, delete: if false;
      }
    }

    // ── คิวงาน — เฉพาะงานของระบบฟอร์มนี้ ────────────────────
    // งาน CAR อยู่คนละโปรเจกต์ จึงรวมมาที่นี่ไม่ได้
    // ── รายชื่อเจ้าหน้าที่ฉบับเต็ม — มี LINE ID และอีเมล ─────
    // ห้ามอ่านโดยไม่ล็อกอินเด็ดขาด ต่างจาก publicDirectory ที่โลกอ่านได้
    match /staffDirectory/{docId} {
      allow read:  if staff();
      allow write: if admin();
    }

    // ── ผังผู้อนุมัติ + ข้อความแจ้งเตือน ─────────────────────
    // อ่านได้ทุกคนที่ล็อกอิน (ฝั่งส่งฟอร์มต้องรู้ว่าใครอนุมัติ)
    // แต่แก้ได้เฉพาะเจ้าหน้าที่
    match /config/{docId} {
      allow read:  if signedIn();
      allow write: if admin();
    }

    // ── คิวแจ้งเตือน — เว็บเขียน Apps Script อ่านไปยิง ──────
    // อ่านไม่ได้จากเว็บ เพราะมี LINE user ID อยู่ในนั้น
    match /notifyQueue/{qid} {
      allow create: if signedIn();
      allow read, update, delete: if false;
    }

    match /tasks/{taskId} {
      allow read:   if staff();
      // ใบที่ส่งเข้ามาต้องสร้างงานให้ผู้อนุมัติเสมอ ไม่งั้นใบค้างโดยไม่มีใครเห็น
      allow create: if staff() || signedIn();
      allow update: if staff();
      allow delete: if false;
    }

    // ── คิวอีเมล — Trigger Email extension อ่านไปส่ง ────────
    // เขียนได้อย่างเดียว อ่านไม่ได้ ไม่งั้นดึงอีเมลคนอื่นได้
    match /mail/{mailId} {
      allow create: if signedIn();
      allow read, update, delete: if false;
    }

    // ปิดทุกอย่างที่ไม่ได้ระบุไว้
    match /{document=**} { allow read, write: if false; }
  }
}
